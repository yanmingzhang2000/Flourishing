    {"exercise_id":"band_face_pull","name":"弹力带面拉","name_en":"Band Face Pull","muscle_group":{"primary":["菱形肌","斜方肌中下束"],"secondary":["三角肌后束"]},"difficulty":2,"equipment":["band_mid"],"function":{"primary":"改善体态","secondary":"紧致"},"category":"strength","target_projects":["round_shoulder_fix"],"contraindications":["shoulder_impingement","rotator_cuff"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["将弹力带固定于眼高位，双手握带","向后拉向面部两侧，肘部外展高于手","挤压肩胛后缓慢回放，做 12-15 次"],"tips":["拉到终点时外旋，像展示二头肌","不耸肩，颈部中立"],"warning":"肩袖或肩峰有伤者从最小阻力起步，疼痛即停。"},
