    {"exercise_id":"arm_circle_warmup","name":"手臂画圈热身","name_en":"Arm Circle Warmup","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"激活","secondary":"放松"},"category":"warmup","target_projects":["tricep_tone"],"contraindications":["shoulder_impingement","rotator_cuff"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["站立，双臂向两侧平举与肩同高，掌心朝下","由小到大缓慢向前画圈 10 次","反向向后画圈 10 次，保持肩颈放松、不耸肩"],"tips":["全程沉肩，避免斜方肌上束代偿发力","如有肩峰撞击或肩袖不适立即停止"],"warning":"肩关节既往伤者画圈幅度控制在舒适范围，疼痛即停。"},
    {"exercise_id":"scapular_wall_slide","name":"靠墙肩胛滑动","name_en":"Scapular Wall Slide","muscle_group":{"primary":["斜方肌中下束"],"secondary":["菱形肌"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"激活","secondary":"改善体态"},"category":"warmup","target_projects":["tricep_tone","round_shoulder_fix"],"contraindications":["neck_pain","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["后背靠墙，双臂屈肘贴墙、手背朝外，肘与肩同高","保持腰背贴墙，沿墙上滑双臂至头顶","缓慢下滑回起始，重复 8-10 次，全程不耸肩"],"tips":["腰后留一手掌空隙即可，避免过度挺腰","颈部放松，下巴微收"],"warning":"颈部或肩关节急性疼痛时暂停练习。"},
    {"exercise_id":"wall_pushup","name":"墙面俯卧撑","name_en":"Wall Push-up","muscle_group":{"primary":["肱三头肌"],"secondary":["胸大肌","前臂"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["tricep_tone"],"contraindications":["wrist_pain","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["面对墙站立，双手撑墙与肩同宽、略高于肩","身体微前倾，屈肘使鼻尖靠近墙面","推墙伸直手臂回到起始，做 10-12 次"],"tips":["全程收紧核心，身体成一条斜线不塌腰","手腕不适可握拳或用推墙手套替代"],"warning":"手腕或肩峰有伤者改用推墙角度更小的版本。"},
    {"exercise_id":"band_tricep_kickback","name":"弹力带臂屈伸","name_en":"Band Tricep Kickback","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂"]},"difficulty":2,"equipment":["band_light"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["tricep_tone"],"contraindications":["elbow_pain","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["双脚踩住弹力带中段，右手握带、屈肘贴紧体侧","上身微前倾，手臂后侧发力将带子向后拉直","缓慢回放，每侧 12-15 次"],"tips":["大臂夹紧不动，只动小臂","肘部有刺痛感立即减小阻力"],"warning":"网球肘或肘部炎症期间暂停。"},
    {"exercise_id":"dumbbell_overhead_ext","name":"站姿哑铃过顶臂屈伸","name_en":"Standing Dumbbell Overhead Extension","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂"]},"difficulty":2,"equipment":["dumbbell_1kg"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["tricep_tone"],"contraindications":["shoulder_impingement","neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["双手托 1kg 哑铃举过头顶，大臂贴近耳侧","屈肘将哑铃缓慢落向颈后","肱三头肌发力伸直手臂，做 10-12 次"],"tips":["上臂保持不动，仅小臂运动","不要耸肩，颈部中立不前伸"],"warning":"肩峰撞击或颈部不适者改用绳索下压变体。"},
    {"exercise_id":"chair_dip","name":"椅子臂屈伸","name_en":"Chair Dip","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂","胸大肌"]},"difficulty":3,"equipment":["bodyweight"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["tricep_tone"],"contraindications":["elbow_pain","wrist_pain","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":50,"steps":["坐椅沿，双手撑椅面边缘、手指朝前","臀部离椅，屈膝屈肘缓慢下沉至大臂约水平","三头肌发力推回起始，做 8-10 次"],"tips":["下沉幅度以肩部无痛为准，勿过度下压","手腕疼可改撑在稳固台阶边缘分散压力"],"warning":"肩肘腕任一部位有伤或疼痛请跳过本动作。"},
    {"exercise_id":"close_grip_pushup","name":"窄距俯卧撑","name_en":"Close-grip Push-up","muscle_group":{"primary":["肱三头肌"],"secondary":["胸大肌","前臂"]},"difficulty":3,"equipment":["bodyweight"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["tricep_tone"],"contraindications":["wrist_pain","shoulder_impingement","elbow_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":50,"steps":["俯卧，双手并拢置于胸部正下方、拇指食指相触","身体成直板，屈肘让胸口接近地面","推起回到直板，做 6-10 次"],"tips":["新手可在垫上以跪姿完成降低难度","手腕不适改用拳头支撑或推墙版"],"warning":"窄距对手腕、肩肘负荷较大，新手务必从跪姿起步。"},
    {"exercise_id":"tricep_cross_stretch","name":"交叉臂屈伸拉伸","name_en":"Cross-body Tricep Stretch","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["tricep_tone"],"contraindications":["shoulder_impingement","neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["左臂横过胸前，右手扶住左肘上方","轻拉左臂向右侧，感受大臂后侧拉伸","保持 20 秒换边，每侧 2 组"],"tips":["不要耸肩，拉伸感在肌肉而非关节","颈部保持中立，不向拉伸侧歪头代偿"],"warning":"肩关节有撞击痛时减小拉扯力度。"},
    {"exercise_id":"foam_roll_tricep","name":"泡沫轴大臂放松","name_en":"Foam Roll Tricep","muscle_group":{"primary":["肱三头肌"],"secondary":["前臂"]},"difficulty":1,"equipment":["foam_roller_plain"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["tricep_tone"],"contraindications":["elbow_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["侧卧，将泡沫轴置于上臂后侧下方","缓慢上下滚动大臂后侧 30-45 秒","换另一侧"],"tips":["压力以微酸可耐受为准，避开肘关节","配合深呼吸放松"],"warning":"肘部炎症期避开滚动，仅放松肌肉中段。"},
    {"exercise_id":"glute_bridge","name":"臀桥","name_en":"Glute Bridge","muscle_group":{"primary":["臀大肌"],"secondary":["腘绳肌"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["hip_thigh_tone","full_body_basic"],"contraindications":["lower_back","sciatica"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["仰卧屈膝，双脚与髋同宽踩地，手臂放体侧","臀部发力将骨盆抬至肩-髋-膝成直线","顶峰夹臀 1 秒，缓慢下落，做 12-15 次"],"tips":["用臀部而非腰发力，避免腰椎过度伸展","核心微收，下巴微收不仰头"],"warning":"腰骶或坐骨神经有症状者减小幅度并咨询医生。"},
    {"exercise_id":"clam_shell","name":"蚌式开合","name_en":"Clam Shell","muscle_group":{"primary":["臀中肌"],"secondary":["臀大肌"]},"difficulty":2,"equipment":["band_light","mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["hip_thigh_tone"],"contraindications":["knee_pain","meniscus"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["侧卧，屈膝约 90 度，双脚并拢，弹力带套于大腿","保持脚掌相触，上方膝盖像蚌壳向上打开","缓慢回放，每侧 12-15 次"],"tips":["骨盆稳定不前倾后仰，仅动髋关节","膝盖打开幅度以无痛为准"],"warning":"膝盖内侧或半月板不适时减小开合角度。"},
    {"exercise_id":"side_lying_leg_lift","name":"侧卧抬腿","name_en":"Side-lying Leg Lift","muscle_group":{"primary":["臀中肌"],"secondary":["臀大肌"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["hip_thigh_tone"],"contraindications":["knee_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":35,"steps":["侧卧，下方手臂枕于头下，双腿伸直叠放","上方腿伸直、脚尖朝前，向侧上方抬起约 30 度","缓慢下落不触地，每侧 12-15 次"],"tips":["身体成一条线，不前后晃","脚尖微微向下可更好孤立臀中肌"],"warning":"膝盖外侧疼痛者减量并咨询康复师。"},
    {"exercise_id":"donkey_kick","name":"驴踢","name_en":"Donkey Kick","muscle_group":{"primary":["臀大肌"],"secondary":["腘绳肌"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["hip_thigh_tone"],"contraindications":["lower_back","knee_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["四点支撑，手肩同宽、膝髋同宽","保持屈膝 90 度，将一侧腿向后上方蹬出","顶峰夹臀后缓慢回放，每侧 12 次"],"tips":["腰部不塌不弓，核心始终收紧","动作慢而可控，避免惯性甩腿"],"warning":"腰椎不稳或膝盖不适时暂停。"},
    {"exercise_id":"bodyweight_squat","name":"自重深蹲","name_en":"Bodyweight Squat","muscle_group":{"primary":["股四头肌","臀大肌"],"secondary":["腘绳肌"]},"difficulty":2,"equipment":["bodyweight","mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["hip_thigh_tone","full_body_basic"],"contraindications":["knee_pain","meniscus","lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["双脚略宽于肩、脚尖微外展站立","屈髋屈膝下蹲至大腿约与地面平行，膝盖朝脚尖方向","脚跟蹬地站起，做 12-15 次"],"tips":["重心落在脚跟，膝盖不超过脚尖过多","背挺直，核心收紧，下蹲时吸气站起呼气"],"warning":"膝痛或半月板损伤者减小下蹲深度，必要时应就医。"},
    {"exercise_id":"fire_hydrant","name":"消防栓式抬腿","name_en":"Fire Hydrant","muscle_group":{"primary":["臀中肌","臀大肌"],"secondary":["腘绳肌"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["hip_thigh_tone"],"contraindications":["lower_back","knee_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["四点支撑，手肩同宽、膝髋同宽","保持屈膝，一侧腿向侧外方抬至与髋同高","缓慢回放，每侧 12 次"],"tips":["骨盆不塌，躯干稳定","抬腿高度以腰不代偿为准"],"warning":"腰部或膝盖有不适时减小幅度。"},
    {"exercise_id":"hip_flexor_stretch","name":"髋屈肌拉伸","name_en":"Hip Flexor Stretch","muscle_group":{"primary":["臀大肌"],"secondary":["内收肌"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["hip_thigh_tone"],"contraindications":["knee_pain","lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["单膝跪地，前腿屈膝 90 度踩实","骨盆微前倾，感受后侧髋部前侧拉伸","保持 20-30 秒换边"],"tips":["后侧膝盖下垫垫子保护","收紧腹部避免腰椎前凸代偿"],"warning":"跪姿膝痛者可改站姿弓步拉伸。"},
    {"exercise_id":"foam_roll_glutes","name":"泡沫轴臀部放松","name_en":"Foam Roll Glutes","muscle_group":{"primary":["臀大肌"],"secondary":["腘绳肌"]},"difficulty":1,"equipment":["foam_roller_plain"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["hip_thigh_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["坐于泡沫轴上，右踝搭左膝呈 4 字","身体微后倾，在右侧臀部缓慢滚动 30-45 秒","换边"],"tips":["压力以可耐受的微酸为准","腰部放松，不僵硬顶腰"],"warning":"腰骶部有症状时减小后倾角度。"},
    {"exercise_id":"hip_warmup_circles","name":"髋部绕环热身","name_en":"Hip Circle Warmup","muscle_group":{"primary":["臀中肌"],"secondary":["臀大肌"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"激活","secondary":"放松"},"category":"warmup","target_projects":["hip_thigh_tone"],"contraindications":["knee_pain","lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["双手叉腰站立，单腿支撑","悬空腿由前向外向后画大圈 8 次","换方向再 8 次，换腿"],"tips":["躯干稳定不晃，仅髋部活动","幅度以无痛舒适为准"],"warning":"膝盖或腰部不适减小画圈幅度。"},
    {"exercise_id":"reverse_lunge","name":"反向箭步蹲","name_en":"Reverse Lunge","muscle_group":{"primary":["股四头肌","臀大肌"],"secondary":["腘绳肌"]},"difficulty":3,"equipment":["bodyweight","mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["hip_thigh_tone","full_body_basic"],"contraindications":["knee_pain","meniscus","lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":50,"steps":["站立，右脚向后撤一大步屈膝下蹲","前腿大腿约平行地面，后膝轻触垫子","前脚跟蹬地站起，每侧 10-12 次"],"tips":["后撤步比前跨更护膝，适合新手","上身直立，核心收紧"],"warning":"膝痛明显者减小步幅或改半程。"},
    {"exercise_id":"dead_bug","name":"死虫式","name_en":"Dead Bug","muscle_group":{"primary":["腹横肌","腹直肌"],"secondary":["下背"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["lower_abs_tone","full_body_basic"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["仰卧举腿屈膝 90 度，双臂伸直指向天花板","对侧手脚缓慢向外延伸接近地面","回到中心换另一侧，交替 10-12 次"],"tips":["腰部始终贴地，不悬空","呼气时延伸，动作慢而稳"],"warning":"腰部无法贴地者减小延伸幅度，腰痛者应咨询医生。"},
    {"exercise_id":"lying_leg_raise","name":"仰卧举腿","name_en":"Lying Leg Raise","muscle_group":{"primary":["腹直肌"],"secondary":["腹斜肌"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["lower_abs_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["仰卧，双腿伸直并拢、脚尖回勾","腹部发力将双腿抬至约 45 度","缓慢下落至离地 10 厘米停住，做 10-12 次"],"tips":["腰部下背贴地，避免用惯性甩腿","手可垫于臀下减轻腰部压力"],"warning":"腰部不适立即屈膝减小难度。"},
    {"exercise_id":"pelvic_tilt","name":"骨盆卷动","name_en":"Pelvic Tilt","muscle_group":{"primary":["腹横肌"],"secondary":["下背"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"激活","secondary":"改善体态"},"category":"strength","target_projects":["lower_abs_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["仰卧屈膝，双脚踩地","呼气时收紧腹部使腰部轻压向地面","吸气放松，重复 10-12 次"],"tips":["动作幅度小，重在腹部控制","颈部与肩膀放松"],"warning":"急性腰痛期暂停。"},
    {"exercise_id":"supine_knee_tuck","name":"仰卧收膝","name_en":"Supine Knee Tuck","muscle_group":{"primary":["腹直肌","腹横肌"],"secondary":["腹斜肌"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["lower_abs_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["仰卧，双腿抬起屈膝呈桌式","腹部发力将膝盖向胸口轻收","缓慢回放但不触地，做 12-15 次"],"tips":["腰部贴地，避免摆动","速度慢，感受下腹收缩"],"warning":"腰部悬空疼痛时改做骨盆卷动。"},
    {"exercise_id":"mountain_climber","name":"登山者","name_en":"Mountain Climber","muscle_group":{"primary":["腹直肌","腹横肌"],"secondary":["肱三头肌"]},"difficulty":3,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"激活"},"category":"strength","target_projects":["lower_abs_tone","full_body_basic"],"contraindications":["wrist_pain","lower_back","knee_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["四点支撑成直板，手肩同宽","交替将膝盖快速提向胸口","保持核心收紧，做 20-30 秒"],"tips":["髋部不塌不翘，身体成直线","新手可放慢速度以降低强度"],"warning":"腕、腰、膝任一不适改用慢速提膝版。"},
    {"exercise_id":"forearm_plank","name":"前臂平板支撑","name_en":"Forearm Plank","muscle_group":{"primary":["腹横肌","腹直肌"],"secondary":["三角肌前束","下背"]},"difficulty":3,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["lower_abs_tone","round_shoulder_fix","full_body_basic"],"contraindications":["wrist_pain","lower_back","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":45,"steps":["俯卧，前臂与肩同宽撑地，脚尖蹬地","抬起身体成直板，肩肘垂直","收紧腹臀，保持 20-40 秒"],"tips":["不塌腰不撅臀，头颈中立","量力而行，宁短勿塌"],"warning":"肩腕腰有伤或疼痛者改做跪姿或放弃。"},
    {"exercise_id":"bird_dog","name":"鸟狗式","name_en":"Bird Dog","muscle_group":{"primary":["腹横肌","下背"],"secondary":["竖脊肌"]},"difficulty":2,"equipment":["mat_6mm"],"function":{"primary":"紧致","secondary":"改善体态"},"category":"strength","target_projects":["lower_abs_tone","full_body_basic"],"contraindications":["lower_back","knee_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":40,"steps":["四点支撑，手肩同宽、膝髋同宽","同时伸出右臂与左腿至与躯干平行","回放换边，交替 10-12 次"],"tips":["骨盆稳定不晃，核心收紧","目光朝下手不仰头"],"warning":"腰部不适时缩短伸展距离。"},
    {"exercise_id":"core_breath_warmup","name":"核心呼吸激活","name_en":"Core Breath Warmup","muscle_group":{"primary":["腹横肌"],"secondary":["下背"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"激活","secondary":"放松"},"category":"warmup","target_projects":["lower_abs_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["站立或仰卧，双手置于下腹","吸气扩张胸腔，呼气时收缩腹部像拉拉链","重复 8-10 次，感受深层腹部收紧"],"tips":["呼气要彻底，腹部向内上提","肩颈放松，不憋气"],"warning":"腰痛急性期为禁忌，应休息。"},
    {"exercise_id":"cat_cow_stretch","name":"猫牛式","name_en":"Cat Cow Stretch","muscle_group":{"primary":["下背"],"secondary":["腹直肌"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["lower_abs_tone","full_body_basic"],"contraindications":["lower_back","neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["四点支撑，吸气时塌腰抬头（牛式）","呼气时拱背低头收腹（猫式）","缓慢交替 8-10 次"],"tips":["动作缓慢配合呼吸","颈部不适时保持视线朝前不低头"],"warning":"颈椎或腰椎急性疼痛时暂停。"},
    {"exercise_id":"seated_forward_fold","name":"坐姿体前屈","name_en":"Seated Forward Fold","muscle_group":{"primary":["腹直肌"],"secondary":["下背"]},"difficulty":1,"equipment":["mat_6mm"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["lower_abs_tone"],"contraindications":["lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["坐姿双腿伸直，脚尖回勾","吸气延展脊柱，呼气从髋部前屈","手沿腿向前，保持 20-30 秒"],"tips":["从髋部折叠而非弓背","微屈膝可减轻腰部压力"],"warning":"腰椎间盘突出者需医生指导。"},
    {"exercise_id":"neck_side_stretch","name":"颈部侧拉伸","name_en":"Neck Side Stretch","muscle_group":{"primary":["斜方肌上束"],"secondary":[]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["trap_relax"],"contraindications":["neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["坐姿或站姿，脊背挺直","右手垂于体侧，左耳轻靠向左肩","右肩下沉，保持 20 秒换边"],"tips":["不耸肩，力度以微拉伸感为准","不憋气，呼吸自然"],"warning":"颈部有放射性疼痛或眩晕时停止并就医。"},
    {"exercise_id":"trap_self_massage_ball","name":"瑜伽球斜方肌自我松解","name_en":"Trap Self-massage with Ball","muscle_group":{"primary":["斜方肌上束"],"secondary":[]},"difficulty":1,"equipment":["yoga_ball_55"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["trap_relax"],"contraindications":["neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["靠墙站立，将瑜伽球置于肩颈交界处斜方肌上束","身体轻压球体上下缓慢滚动 30 秒","换另一侧"],"tips":["避开颈椎骨突，仅压肌肉","压力以舒适微酸为准"],"warning":"颈部有损伤或炎症者慎用，建议先就医确认。"},
    {"exercise_id":"shoulder_shrug_release","name":"耸肩释放","name_en":"Shoulder Shrug Release","muscle_group":{"primary":["斜方肌上束"],"secondary":[]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"放松","secondary":"激活"},"category":"warmup","target_projects":["trap_relax"],"contraindications":["neck_pain","shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["自然站立，双臂垂于体侧","吸气耸肩向耳靠近，呼气缓慢下沉放松","重复 8-10 次，感受肩颈落差"],"tips":["下沉时彻底放松，不憋劲","配合呼气更解压"],"warning":"肩颈急性疼痛时减小幅度。"},
    {"exercise_id":"neck_rotation_warmup","name":"颈部缓慢绕转","name_en":"Neck Rotation Warmup","muscle_group":{"primary":["斜方肌上束"],"secondary":[]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"放松","secondary":"激活"},"category":"warmup","target_projects":["trap_relax"],"contraindications":["neck_pain"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["坐姿挺胸，目光平视","缓慢将头向左、向下、向右画半圆","反向重复 4-6 次"],"tips":["幅度小且慢，不快速甩头","不憋气，不抗阻"],"warning":"有眩晕、颈椎病史者仅做左右侧倾，禁止绕环。"},
    {"exercise_id":"doorway_pec_stretch","name":"门框胸肌拉伸","name_en":"Doorway Pec Stretch","muscle_group":{"primary":["胸大肌"],"secondary":["三角肌前束"]},"difficulty":1,"equipment":["bodyweight"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["trap_relax","round_shoulder_fix"],"contraindications":["shoulder_impingement"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["站门框旁，前臂贴门框、肘约 90 度","身体微前倾，感受胸前拉伸","保持 20-30 秒换边"],"tips":["不塌腰，重心轻移即可","肩前束有撞击痛时减小角度"],"warning":"肩峰撞击者减小外展角度。"},
