    {"exercise_id":"foam_roll_upper_back","name":"泡沫轴上背放松","name_en":"Foam Roll Upper Back","muscle_group":{"primary":["斜方肌上束"],"secondary":["竖脊肌"]},"difficulty":1,"equipment":["foam_roller_plain"],"function":{"primary":"放松","secondary":"改善体态"},"category":"stretch","target_projects":["trap_relax","round_shoulder_fix"],"contraindications":["neck_pain","lower_back"],"alternative_exercise_ids":[],"review_status":"approved","rest_seconds":30,"steps":["仰卧将泡沫轴置于上背部，双手抱头或交叉胸前","屈膝蹬地，缓慢上下滚动肩胛区间","滚动 30-45 秒，避开颈椎与腰椎"],"tips":["颈部不悬空，可双手托住头","不滚到腰，仅上背"],"warning":"颈部或腰椎有伤者跳过本动作。"},
