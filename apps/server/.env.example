PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/flourish.db

# AI Copilot: required for chat responses. Without it, Copilot degrades
# gracefully (returns a "service unavailable" message); core training flow
# is unaffected (05-ACCEPTANCE E2E #5).
# Supports OpenAI-compatible providers (e.g. SiliconFlow):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
