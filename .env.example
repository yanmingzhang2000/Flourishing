# Flourish AI Training - Environment Variables

# JWT_SECRET (REQUIRED in production)
# Generate with: openssl rand -base64 32
# or PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=your-secure-random-secret-min-32-chars

# CORS_ORIGIN (default: http://localhost)
# Set to your frontend domain in production (e.g., https://flourish.example.com)
CORS_ORIGIN=http://localhost
